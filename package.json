{
  "name": "on-off-listener",
  "version": "1.0.0",
  "description": "Tiny type-safe helper for addEventListener with built-in cleanup.",
  "keywords": [
    "event-listener",
    "typescript",
    "dom",
    "cleanup",
    "delegate"
  ],
  "type": "module",
  "scripts": {
    "gen-types:browser": "bun run ./scripts/extract-types.ts node_modules/typescript/lib/lib.dom.d.ts > ./src/types/generated/lib.dom.ts"
  },
  "exports": {
    "browser": {
      "import": "./src/browser.ts"
    }
  },
  "author": {
    "name": "Askar Yusupov"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/pyoner/on-off-listener"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/bun": "^1.3.0"
  },
  "peerDependencies": {
    "typescript": "5.9.3"
  },
  "dependencies": {}
}
